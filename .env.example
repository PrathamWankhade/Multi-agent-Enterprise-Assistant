# Copy to .env and adjust for your deployment.

# --- Authentication / RBAC -------------------------------------------------
# Set AUTH_ENABLED=true to require a JWT (from /api/v1/auth/login) or an
# X-API-Key on every protected endpoint. Default admin / employee accounts are
# seeded on first run: admin / Admin123! and employee / User123!
AUTH_ENABLED=true
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7

# Optional static keys, format "key1:admin,key2:user,key3:viewer".
API_KEYS=

# --- App -------------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
SQLITE_PATH=./data/enterprise.db
