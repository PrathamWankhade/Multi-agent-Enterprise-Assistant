# ---------------------------------------------------------------------------
# Multi-Agent Enterprise Assistant - example configuration
# Copy to .env and fill in. Every section is optional: anything left blank or
# left as a placeholder falls back automatically (see README "Graceful
# degradation"). Never commit your real .env.
# ---------------------------------------------------------------------------

# --- LLM: Azure OpenAI (leave blank to skip) -------------------------------
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- LLM: OpenAI or any OpenAI-compatible endpoint (e.g. Ollama) -----------
# Local Ollama example:
#   OPENAI_API_KEY=ollama
#   OPENAI_BASE_URL=http://localhost:11434/v1
#   OPENAI_MODEL=qwen3.5:4b
#   OPENAI_EMBEDDING_MODEL=nomic-embed-text
# Hosted OpenAI example:
#   OPENAI_API_KEY=sk-...
#   OPENAI_BASE_URL=            (leave empty for api.openai.com)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Azure cloud (optional; local Ollama works without any of this) ---------
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

AZURE_AI_SEARCH_ENDPOINT=
AZURE_AI_SEARCH_API_KEY=
AZURE_AI_SEARCH_INDEX_NAME=enterprise-kb
AZURE_AI_SEARCH_API_VERSION=2024-07-01

# Passwordless: use DefaultAzureCredential instead of keys (needs requirements-azure.txt)
AZURE_USE_MANAGED_IDENTITY=false

# --- Vector store: Qdrant --------------------------------------------------
# Local:  QDRANT_HOST=localhost  QDRANT_PORT=6333
# Cloud:  QDRANT_HOST=https://xxxx.cloud.qdrant.io  QDRANT_API_KEY=<key>
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=enterprise_kb

# --- Vector store: Azure AI Search (alternative to Qdrant) -----------------
AZURE_AI_SEARCH_ENDPOINT=
AZURE_AI_SEARCH_API_KEY=
AZURE_AI_SEARCH_INDEX_NAME=enterprise-kb

# --- Memory: Redis ---------------------------------------------------------
# Local:  REDIS_HOST=localhost  REDIS_PORT=6379  REDIS_PASSWORD=
# Cloud:  REDIS_HOST=xxx.db.redis.io  REDIS_PORT=<port>  REDIS_PASSWORD=<db password>
# If Redis is unreachable the app uses a shared in-process store instead
# (history is then lost on restart).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
MEMORY_TTL_SECONDS=86400

# --- Application -----------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
LOG_LEVEL=INFO

# --- Security --------------------------------------------------------------
SECRET_KEY=change-this-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000

# --- Execution Agent -------------------------------------------------------
# Comma-separated domains the Execution Agent is allowed to call.
ALLOWED_EXECUTION_DOMAINS=
EXECUTION_REQUIRE_APPROVAL=true

# --- Review Agent (grounding / hallucination check) -------------------------
# Deterministic checks always run. The LLM pass adds ~1 model call per answer;
# set REVIEW_LLM_ENABLED=false on slow CPUs to keep answers fast.
REVIEW_ENABLED=true
REVIEW_LLM_ENABLED=true

# --- Enterprise tools -------------------------------------------------------
# Mock HR/IT tools backed by SQLite; write tools require human approval.
TOOLS_ENABLED=true
SQLITE_PATH=data/enterprise.db
REPORTS_DIR=reports

# --- Security & monitoring (Phase 5) -----------------------------------------
# Auth is OFF by default. When enabled, send X-API-Key (or Bearer) header.
# Roles: viewer = read-only, user = chat/ingest, admin = approvals/audit.
AUTH_ENABLED=false
# Format: "key1:admin,key2:user,key3:viewer" — use long random keys!
API_KEYS=

# Structured audit trail -> logs/audit-YYYY-MM-DD.log (gitignored)
AUDIT_DIR=logs
# Per-agent execution timings returned in /chat and /tasks/{id}/trace
TRACING_ENABLED=true
